{
  "name": "shopify-webhook-sender",
  "version": "2.0.0-beta.2",
  "description": "A CLI to send Shopify webhooks using live data, shaped against a reference payload.",
  "author": "Abdulla Haseeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasibmlp/shopify-webhook-sender.git"
  },
  "keywords": [
    "shopify",
    "webhook",
    "sender",
    "replay",
    "api",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "shopify-webhook-sender": "bin/sws.js",
    "sws": "bin/sws.js",
    "send-shopify-webhook": "bin/send-shopify-webhook.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "diff": "tsx src/diff.ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/deep-diff": "^1.0.5",
    "@types/ini": "^1.3.34",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/update-notifier": "^6.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "deep-diff": "^1.0.2",
    "dotenv": "^17.2.3",
    "ini": "^4.1.1",
    "minimist": "^1.2.8",
    "prompts": "^2.4.2",
    "update-notifier": "^7.0.0"
  }
}
